MONGO_URI=mongodb://localhost:27017/
MONGO_DB=sproc
MONGO_COLLECTION=user-details
CORS_ORIGINS=
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_JSON_MODE=true
LLM_TIMEOUT=60
LLM_RETRIES=3
EVAL_DELAY_SECONDS=1
MAX_ANSWER_CHARS=4000
OUTPUT_XLSX=user_pseudocode_scores.xlsx

# Staff dashboard login. Staff login is disabled until BOTH are set; use a long password.
STAFF_USERNAME=
STAFF_PASSWORD=
# Signs session cookies. Set a long random value (e.g. `openssl rand -hex 32`) so logins survive restarts.
SECRET_KEY=
# Set true when serving over HTTPS so cookies are marked Secure.
COOKIE_SECURE=false
SESSION_HOURS=12

# How often the grading worker polls MongoDB for jobs (seconds).
WORKER_POLL_SECONDS=5

# Run the grading worker inside the web process (single-service hosts such as Render's free plan).
EMBEDDED_WORKER=false
